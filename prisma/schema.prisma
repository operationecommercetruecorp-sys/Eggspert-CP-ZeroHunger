generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  developer
  admin
  cp
  teacher
  student
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String   @id @default(cuid())
  role          Role
  email         String?  @unique
  passwordHash  String
  nameTh        String
  nameEn        String
  phone         String?
  photoUrl      String?
  isMainContact Boolean  @default(false)
  schoolId      String?
  school        School?  @relation(fields: [schoolId], references: [id])
  createdAt     DateTime @default(now())

  @@index([schoolId])
  @@index([role])
}

model School {
  id            String         @id @default(cuid())
  name          String
  location      String
  joinedDate    DateTime       @default(now())
  code          String         @unique
  passwordHash  String
  users         User[]
  eggLogs       EggLog[]
  waterFeedLogs WaterFeedLog[]
  iotDevices    IotDevice[]
  photos        Photo[]
  documents     SyllabusDoc[]
  news          News[]
}

model Application {
  id        String            @id @default(cuid())
  name      String
  school    String
  phone     String
  email     String
  address   String
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())

  @@index([status])
}

model ProjectResult {
  id             String   @id @default(cuid())
  updateDate     DateTime
  provinces      Int
  countries      Int
  schoolCount    Int
  studentCount   Int
  staffCount     Int
  communityCount Int
  eggsPerCycle   String
  createdAt      DateTime @default(now())

  @@index([updateDate])
}

model EggLog {
  id       String   @id @default(cuid())
  schoolId String
  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date     DateTime
  count    Int

  @@index([schoolId, date])
}

model WaterFeedLog {
  id       String   @id @default(cuid())
  schoolId String
  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date     DateTime
  type     String
  action   String
  amount   String

  @@index([schoolId, date])
}

model IotDevice {
  id          String       @id @default(cuid())
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  type        String
  status      String
  deviceKey   String       @unique
  installedAt DateTime
  readings    IotReading[]

  @@index([schoolId])
}

model IotReading {
  id         String    @id @default(cuid())
  deviceId   String
  device     IotDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  temp       Float
  humidity   Float
  water      Float
  feed       Float
  recordedAt DateTime  @default(now())

  @@index([deviceId, recordedAt])
}

model Photo {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  url         String
  publishedAt DateTime @default(now())

  @@index([schoolId])
}

model SyllabusDoc {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title     String
  type      String
  fileUrl   String
  status    String   @default("draft")
  createdAt DateTime @default(now())

  @@index([schoolId])
}

model News {
  id        String   @id @default(cuid())
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title     String
  body      String
  createdAt DateTime @default(now())

  @@index([schoolId])
}

model LearningArticle {
  id        String    @id @default(cuid())
  tag       String
  title     String
  body      String
  imageUrl  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  embedding Embedding?
}

model NotificationEmail {
  id    String @id @default(cuid())
  email String @unique
}

// Retrieval index for the "ask the Eggspert" assistant (Phase 4).
// sourceType/sourceId point at LearningArticle, News, or ProjectResult rows;
// content is the chunked text that was embedded, vector stored as JSON floats
// (no pgvector extension assumed available on arbitrary hosted Postgres).
model Embedding {
  id                String           @id @default(cuid())
  sourceType        String
  sourceId          String
  content           String
  vector            Json
  learningArticleId String?          @unique
  learningArticle   LearningArticle? @relation(fields: [learningArticleId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())

  @@index([sourceType, sourceId])
}
