# Postgres connection string. For local dev, run `npm run db:start` (self-contained,
# no Docker/Homebrew needed) and use the URL it prints — defaults to the one below.
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/eggspert"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Resend (transactional email for application-submitted notifications)
RESEND_API_KEY=""
EMAIL_FROM="Eggspert <notifications@example.org>"

# OpenAI (embeddings for "ask the Eggspert" retrieval + answer generation)
OPENAI_API_KEY=""

# File storage: "local" writes to public/uploads (dev default). Swap to "s3" once
# real object storage credentials exist — see lib/storage.ts.
STORAGE_DRIVER="local"
