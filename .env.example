# Postgres connection string. For local dev, run `npm run db:start` (self-contained,
# no Docker/Homebrew needed) and use the URL it prints — defaults to the one below.
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/eggspert"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Resend (transactional email for application-submitted notifications)
RESEND_API_KEY=""
EMAIL_FROM="Eggspert <notifications@example.org>"

# OpenAI (embeddings for "ask the Eggspert" retrieval + answer generation)
OPENAI_API_KEY=""

# File storage: "local" writes to public/uploads (dev default). Set to "s3" for any
# S3-compatible store (AWS S3, Supabase Storage, Cloudflare R2, MinIO) — see lib/storage.ts.
STORAGE_DRIVER="local"
# Only needed when STORAGE_DRIVER=s3:
S3_BUCKET=""
S3_REGION="auto"
# Leave S3_ENDPOINT unset for real AWS S3. Set it for anything else, e.g.:
#   Supabase Storage: https://<project-ref>.supabase.co/storage/v1/s3
#   Cloudflare R2:     https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL uploaded files are served from (bucket must allow public read, or put a
# CDN in front of it). e.g. https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
S3_PUBLIC_URL_BASE=""
